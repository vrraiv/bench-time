// Cloudflare Worker that serves the built site (dist/) as static assets: a restricted preview.
//
// Both addresses are protected by Cloudflare Access (enabled in the dashboard 2026-11-19; an Access
// application covers the Worker and its preview URLs). Do not deploy under a new name with these
// switched on: deploy the new Worker with both false, enable Access on it, then switch them on.
//
// The Worker name is part of the address; it is a working name and can be changed before step 1.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docket-watch",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": true,
  // The Worker script answers /api/* (replies to the Questions for review page) and hands every
  // other request to the static assets. See worker/index.js.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Replies database (schema in worker/schema.sql). ACCESS_TEAM_DOMAIN and ACCESS_AUD are Worker
  // secrets (wrangler secret put), not kept here.
  "d1_databases": [
    {
      "binding": "REPLIES",
      "database_name": "docket-watch-replies",
      "database_id": "e1acccaf-1904-4b12-b5cc-f8be860a4773"
    }
  ]
}
